set(packaged_config "$<CONFIG>")
if(NOT packaged_config STREQUAL "Release")
    message(FATAL_ERROR "Portable archives require a Release build; configure CMAKE_BUILD_TYPE=Release or build --config Release")
endif()
set(APP "$<TARGET_FILE:torrent_desktop>")
set(DESTINATION "${CMAKE_INSTALL_PREFIX}")
file(MAKE_DIRECTORY "${DESTINATION}")
file(INSTALL DESTINATION "${DESTINATION}" TYPE EXECUTABLE FILES "${APP}")
set(TOOLCHAIN_BIN "@PORTABLE_TOOLCHAIN_BIN@")
set(RUNTIME_DIRECTORIES "@PORTABLE_RUNTIME_DIRECTORIES@")
set(system_runtime "@PORTABLE_SYSTEM_RUNTIME@")
foreach(runtime IN LISTS system_runtime)
    get_filename_component(directory "${runtime}" DIRECTORY)
    list(APPEND RUNTIME_DIRECTORIES "${directory}")
endforeach()
include("@PROJECT_SOURCE_DIR@/desktop/copy_runtime.cmake")
if(system_runtime)
    file(COPY ${system_runtime} DESTINATION "${DESTINATION}")
endif()
file(INSTALL DESTINATION "${DESTINATION}" TYPE FILE FILES
    "@PROJECT_SOURCE_DIR@/packaging/README.txt" "@PROJECT_SOURCE_DIR@/packaging/THIRD_PARTY_NOTICES.txt")
set(notices "@PORTABLE_LICENSE_FILES@")
foreach(notice IN LISTS notices)
    if(NOT EXISTS "${notice}" OR IS_DIRECTORY "${notice}")
        message(FATAL_ERROR "Portable notice file is missing: ${notice}")
    endif()
    get_filename_component(name "${notice}" NAME)
    get_filename_component(parent "${notice}" DIRECTORY)
    get_filename_component(component "${parent}" NAME)
    file(INSTALL DESTINATION "${DESTINATION}/licenses/${component}" TYPE FILE FILES "${notice}")
endforeach()
file(WRITE "${DESTINATION}/BUILD-INFO.txt"
    "TorrentClient @PROJECT_VERSION@\nConfiguration: ${packaged_config}\nArchitecture: @portable_arch@\nCompiler: @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@\n")
file(GLOB_RECURSE files RELATIVE "${DESTINATION}" LIST_DIRECTORIES FALSE "${DESTINATION}/*")
list(SORT files)
set(manifest "")
foreach(file IN LISTS files)
    if(file STREQUAL "SHA256SUMS.txt")
        continue()
    endif()
    file(SHA256 "${DESTINATION}/${file}" digest)
    string(APPEND manifest "${digest}  ${file}\n")
endforeach()
file(WRITE "${DESTINATION}/SHA256SUMS.txt" "${manifest}")
