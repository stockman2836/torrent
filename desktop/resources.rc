1 24 "app.manifest"

#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#pragma code_page(65001)
IDD_SEEDING DIALOGEX 0, 0, 310, 178
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Настройки раздачи"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Продолжать раздачу после завершения", IDC_SEED_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 286, 18
    LTEXT "Остановить при коэффициенте", -1, 12, 44, 190, 16
    EDITTEXT IDC_SEED_RATIO, 215, 41, 78, 20, ES_AUTOHSCROLL
    LTEXT "Остановить через (часы)", -1, 12, 72, 190, 16
    EDITTEXT IDC_SEED_HOURS, 215, 69, 78, 20, ES_AUTOHSCROLL
    LTEXT "Коэффициент = отдано за сеанс / размер торрента.\n0 — без ограничения. Сработает первый достигнутый лимит. Настройки можно менять во время раздачи.", -1, 12, 100, 286, 38
    DEFPUSHBUTTON "Применить", IDOK, 146, 151, 72, 20
    PUSHBUTTON "Отмена", IDCANCEL, 226, 151, 72, 20
END

IDD_NETWORK_SETTINGS DIALOGEX 0, 0, 350, 244
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Настройки сети"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Общие настройки для всех раздач", -1, 12, 12, 326, 16
    LTEXT "Начальный порт подключений", -1, 12, 42, 210, 16
    EDITTEXT IDC_NET_FIRST_PORT, 242, 39, 96, 20, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Максимум пиров на одну раздачу", -1, 12, 72, 220, 16
    EDITTEXT IDC_NET_MAX_PEERS, 242, 69, 96, 20, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "DHT — поиск пиров без трекера", IDC_NET_DHT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 101, 326, 18
    CONTROL "PEX — обмен адресами между пирами", IDC_NET_PEX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 126, 326, 18
    LTEXT "Для нескольких раздач порты назначаются автоматически начиная с указанного. Фактический порт показан у раздачи.", -1, 12, 156, 326, 28
    LTEXT "Изменения сохраняются и применяются при следующем запуске раздачи. Текущие подключения продолжают работу.", -1, 12, 189, 326, 27
    DEFPUSHBUTTON "Сохранить", IDOK, 180, 222, 76, 18
    PUSHBUTTON "Отмена", IDCANCEL, 264, 222, 74, 18
END

IDD_NETWORK DIALOGEX 0, 0, 640, 368
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Пиры и трекер"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_NET_HINT, 12, 12, 616, 18
    LTEXT "", IDC_NET_SUMMARY, 12, 36, 616, 18
    LTEXT "Активный трекер", -1, 12, 60, 616, 12
    EDITTEXT IDC_NET_TRACKER_URL, 12, 74, 616, 18, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "", IDC_NET_TRACKER_STATE, 12, 98, 616, 18
    EDITTEXT IDC_NET_TRACKER_ERROR, 12, 119, 616, 28, ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Текущие подключения", -1, 12, 153, 616, 12
    CONTROL "", IDC_NET_PEERS, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 12, 168, 616, 135
    EDITTEXT IDC_NET_PEER_ERROR, 12, 313, 616, 20, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "Статистика пиров относится к текущему сеансу.", -1, 12, 347, 510, 12
    DEFPUSHBUTTON "Закрыть", IDOK, 540, 341, 88, 22
END
