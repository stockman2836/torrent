1 24 "app.manifest"

#include <windows.h>
#include "resource.h"
#pragma code_page(65001)
IDD_SEEDING DIALOGEX 0, 0, 310, 178
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Настройки раздачи"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Продолжать раздачу после завершения", IDC_SEED_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 286, 18
    LTEXT "Остановить при коэффициенте", -1, 12, 44, 190, 16
    EDITTEXT IDC_SEED_RATIO, 215, 41, 78, 20, ES_AUTOHSCROLL
    LTEXT "Остановить через (часы)", -1, 12, 72, 190, 16
    EDITTEXT IDC_SEED_HOURS, 215, 69, 78, 20, ES_AUTOHSCROLL
    LTEXT "Коэффициент = отдано за сеанс / размер торрента.\n0 — без ограничения. Сработает первый достигнутый лимит. Настройки можно менять во время раздачи.", -1, 12, 100, 286, 38
    DEFPUSHBUTTON "Применить", IDOK, 146, 151, 72, 20
    PUSHBUTTON "Отмена", IDCANCEL, 226, 151, 72, 20
END
