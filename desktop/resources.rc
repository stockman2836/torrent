1 24 "app.manifest"

#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#pragma code_page(65001)
IDD_SEEDING DIALOGEX 0, 0, 310, 178
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Настройки раздачи"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Продолжать раздачу после завершения", IDC_SEED_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 286, 18
    LTEXT "Остановить при коэффициенте", -1, 12, 44, 190, 16
    EDITTEXT IDC_SEED_RATIO, 215, 41, 78, 20, ES_AUTOHSCROLL
    LTEXT "Остановить через (часы)", -1, 12, 72, 190, 16
    EDITTEXT IDC_SEED_HOURS, 215, 69, 78, 20, ES_AUTOHSCROLL
    LTEXT "Коэффициент = отдано за сеанс / размер торрента.\n0 — без ограничения. Сработает первый достигнутый лимит. Настройки можно менять во время раздачи.", -1, 12, 100, 286, 38
    DEFPUSHBUTTON "Применить", IDOK, 146, 151, 72, 20
    PUSHBUTTON "Отмена", IDCANCEL, 226, 151, 72, 20
END

IDD_NETWORK_SETTINGS DIALOGEX 0, 0, 350, 283
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Настройки сети"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Общие настройки для всех раздач", -1, 12, 12, 326, 16
    LTEXT "Начальный порт подключений", -1, 12, 42, 210, 16
    EDITTEXT IDC_NET_FIRST_PORT, 242, 39, 96, 20, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Максимум пиров на одну раздачу", -1, 12, 72, 220, 16
    EDITTEXT IDC_NET_MAX_PEERS, 242, 69, 96, 20, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "DHT — поиск пиров без трекера", IDC_NET_DHT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 101, 326, 18
    CONTROL "PEX — обмен адресами между пирами", IDC_NET_PEX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 126, 326, 18
    CONTROL "Открывать порты на роутере (UPnP/NAT-PMP)", IDC_NET_PORT_MAPPING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 151, 326, 18
    LTEXT "Для нескольких раздач порты назначаются автоматически начиная с указанного. Фактический порт показан у раздачи.", -1, 12, 180, 326, 28
    LTEXT "Порты, лимит пиров, DHT и PEX применяются при следующем запуске раздачи. Автооткрытие портов включается и выключается сразу для всех активных раздач.", -1, 12, 213, 326, 38
    DEFPUSHBUTTON "Сохранить", IDOK, 180, 259, 76, 18
    PUSHBUTTON "Отмена", IDCANCEL, 264, 259, 74, 18
END

IDD_GLOBAL_SPEED DIALOGEX 0, 0, 350, 199
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Общие лимиты скорости"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Скорость всех торрентов вместе (КиБ/с)", -1, 12, 12, 326, 16
    LTEXT "Скачивание", -1, 12, 42, 210, 16
    EDITTEXT IDC_GLOBAL_DOWNLOAD, 242, 39, 96, 20, ES_AUTOHSCROLL
    LTEXT "Отдача", -1, 12, 72, 210, 16
    EDITTEXT IDC_GLOBAL_UPLOAD, 242, 69, 96, 20, ES_AUTOHSCROLL
    LTEXT "0 — без ограничения. Лимиты отдельных торрентов продолжают действовать.", -1, 12, 103, 326, 28
    LTEXT "Изменения сохраняются и сразу действуют на активные загрузки и раздачи.", -1, 12, 138, 326, 26
    DEFPUSHBUTTON "Применить", IDOK, 180, 175, 76, 18
    PUSHBUTTON "Отмена", IDCANCEL, 264, 175, 74, 18
END

IDD_NETWORK DIALOGEX 0, 0, 640, 368
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Пиры и трекер"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_NET_HINT, 12, 12, 616, 16
    LTEXT "", IDC_NET_SUMMARY, 12, 32, 616, 14
    LTEXT "", IDC_NET_PORT, 12, 50, 616, 26
    LTEXT "", IDC_NET_INCOMING, 12, 79, 616, 22
    EDITTEXT IDC_NET_ADVICE, 12, 105, 616, 34, ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Активный трекер", -1, 12, 145, 616, 12
    EDITTEXT IDC_NET_TRACKER_URL, 12, 159, 616, 18, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "", IDC_NET_TRACKER_STATE, 12, 181, 616, 16
    EDITTEXT IDC_NET_TRACKER_ERROR, 12, 201, 616, 24, ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Текущие подключения", -1, 12, 231, 616, 12
    CONTROL "", IDC_NET_PEERS, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 12, 245, 616, 73
    EDITTEXT IDC_NET_PEER_ERROR, 12, 322, 616, 18, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "Статистика относится к текущему сеансу.", -1, 12, 351, 330, 12
    PUSHBUTTON "Скопировать отчёт", IDC_NET_COPY, 350, 344, 174, 20
    DEFPUSHBUTTON "Закрыть", IDOK, 540, 344, 88, 20
END
